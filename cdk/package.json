{
  "name": "domain-redirector-cdk",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for managing HTTP redirects across multiple domains using CloudFront",
  "license": "MIT",
  "main": "lib/redirect-stack.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathanspiva/redirector.git"
  },
  "keywords": [
    "aws",
    "cdk",
    "cloudfront",
    "redirect",
    "domain",
    "infrastructure"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "validate": "ts-node lib/config/validator.ts",
    "preflight": "ts-node scripts/preflight-check.ts",
    "smoke-test": "ts-node scripts/smoke-test.ts",
    "deploy": "cdk deploy RedirectStack --require-approval never --outputs-file outputs.json"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1149.0",
    "cdk-nag": "^3.1.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1176.0",
    "@aws-sdk/client-route-53": "^3.1176.0",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
