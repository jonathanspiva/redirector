# Domain Redirector - environment configuration
#
# Copy this file to .env (`cp .env.example .env`) and fill in the values.
# .env is gitignored and loaded automatically by bin/app.ts, so you do not
# need to `export` anything. Variables already set in your shell take
# precedence over this file.

# --- Required ---

# AWS account ID to deploy into. The region is always us-east-1 because
# CloudFront certificates (ACM) must live there - it is not configurable.
CDK_DEFAULT_ACCOUNT=123456789012

# --- CI/CD pipeline (optional) ---
#
# Set all three GITHUB_* values to have CDK create a CodePipeline that
# redeploys automatically on every push. Leave them blank to skip the
# pipeline and deploy redirects manually with `cdk deploy RedirectStack`.
#
# GITHUB_CONNECTION_ARN comes from a one-time AWS Console step:
#   Developer Tools -> Settings -> Connections -> Create connection
#   -> GitHub -> authorize -> copy the resulting connection ARN.
GITHUB_CONNECTION_ARN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# Branch the pipeline watches (optional, defaults to main).
GITHUB_BRANCH=main
